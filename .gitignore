# ~/.claude is a config dir full of runtime state, transcripts, and secrets.
# Strategy: ignore EVERYTHING at the root by default, then re-include only the
# authored skill set. This is safer than denylisting noise â€” a new runtime file
# or cache dir can never accidentally get tracked.

/*

# --- Re-include the authored skill set ---
!/commands/
!/agents/
!/skills/
!/CLAUDE.md
!/REVIEWER_CONVENTIONS.md
!/PROJECTS.md
!/FIX_LOG.md
!/DECISIONS.md
!/.gitattributes
!/hooks/
!/statusline.ps1
!/new-app.ps1
!/powershell-profile.ps1
!/sync-profile.ps1
!/settings.json
!/.gitignore

# Machine-local backup of the pre-cleanup permission list â€” never track.
settings.local.json.pre-cleanup

# --- Defense in depth: never track secrets or machine-local overrides, even if
#     a rule above is ever widened. ---
.credentials.json
settings.local.json
*.key
*.pem
*.p12
.env
.env.*
