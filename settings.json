{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/jtakh/.claude/statusline.ps1"
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default",
  "permissions": {
    "deny": [
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.*.local)",
      "Read(~/**/.env.production)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
