{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/jtakh/.claude/statusline.ps1"
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.*.local)",
      "Read(~/**/.env.production)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:/Users/jtakh/.claude/hooks/shell_guard.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/jtakh/.claude/hooks/format-after-edit.ps1"
          }
        ]
      }
    ]
  }
}
