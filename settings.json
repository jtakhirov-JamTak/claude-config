{
  "permissions": {
    "deny": [
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:/Users/jtakh/.claude/hooks/shell_guard.py"
            ]
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python C:/Users/jtakh/.claude/statusline.py"
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default"
}
